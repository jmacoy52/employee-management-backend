# Server
PORT=5000

# MySQL connection (Aiven: copy the Service URI). Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
DB_URL=mysql://avnadmin:CHANGE_ME@emplocore-mysql-emplocore.l.aivencloud.com:20452/defaultdb?ssl-mode=REQUIRED

# TLS: provide the server CA certificate in ONE of these ways
# DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem     # Render "Secret File"
# DB_SSL_CA_BASE64=LS0tLS1CRUdJTi...           # base64 of the PEM
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL=true                                  # forced on/off (default: on when ssl-mode=REQUIRED)
# DB_SSL_REJECT_UNAUTHORIZED=true              # keep true in production
# DB_CONNECTION_LIMIT=5

# Auth
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Demo data: load db/seed.sql during "npm run db:init" (leave false in production)
SEED_DEMO=false
# Public demo deployment (protects the demo logins). Set false for a real deployment.
# Unset = automatic (on with SEED_DEMO=true; otherwise the demo logins are protected only if they exist)
# DEMO_MODE=false

# Brute-force protection on login/register/reset (per IP)
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MIN=15

# Public organisation sign-up limit (per IP)
# ORG_SIGNUP_RATE_LIMIT_MAX=5
# ORG_SIGNUP_RATE_LIMIT_WINDOW_MIN=60

# Public "Request a demo" form limit (per IP)
# ENQUIRY_RATE_LIMIT_MAX=5
# ENQUIRY_RATE_LIMIT_WINDOW_MIN=60

# One-time owner bootstrap: bcrypt hash of the setup token (overrides config/ownerBootstrap.js)
# OWNER_SETUP_TOKEN_HASH=

# Admin-generated password reset links expire after this many minutes
# RESET_LINK_TTL_MINUTES=60
# Demo mode only: logins that cannot be deleted/deactivated/re-roled/password-reset (default: the 3 demo logins; empty = off)
# DEMO_PROTECTED_EMAILS=admin@emplocore.demo,hr@emplocore.demo,kwame.mensah@emplocore.demo

# CORS (comma-separated; * wildcards allowed in the host)
ALLOWED_ORIGINS=https://emplocore.vercel.app,https://emplocore-*.vercel.app,http://localhost:3000

# Tests only (npm test): a disposable LOCAL database that will be wiped
# TEST_DB_URL=mysql://USER:PASSWORD@127.0.0.1:3307/emplocore_test?ssl-mode=REQUIRED
